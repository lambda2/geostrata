{
	"name": "@geostrata/registry",
	"version": "1.0.0",
	"description": "Geostrata YAML registry compiler to SQLite (FTS5 + R-Tree)",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsx src/build.ts",
		"build:site": "tsx src/build.ts && python3 ../qgis-plugin/scripts/package_plugin.py && python3 ../website/build_site.py",
		"deploy:qgis": "tsx src/ingest/run-ingest.ts && tsx src/build.ts && python3 ../qgis-plugin/scripts/deploy_qgis.py",
		"healthcheck": "tsx src/healthcheck.ts",
		"ingest": "tsx src/ingest/run-ingest.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"better-sqlite3": "^11.8.1",
		"yaml": "^2.7.0",
		"zod": "^3.24.2"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^7.6.12",
		"@types/node": "^22.13.4",
		"tsx": "^4.19.3",
		"typescript": "^5.7.3"
	},
	"allowScripts": {
		"better-sqlite3": true,
		"esbuild": true
	}
}
